*.log

# Scratch/test apps — not workspace members, carry their own build output
/hotreload_test/
/mobile_journey/

# ── Nested sibling repos ──────────────────────────────────────────────
# These live inside this folder so everything ROSACE is in one place, but
# each is GIT-INDEPENDENT: its own repo, own remote, own history. This
# repo never tracks or commits them. Each is the source of truth for its
# own contents — clone or pull it separately.
#
#   examples/  github.com/rosace-ui/rosace-examples   example apps + showcase
#   page/      github.com/rosace-ui/rosace-page       the website (rosace.godwinj.com)
#
# NOTE: `docs/` is NOT one of these — it is tracked by THIS repo (the
# mdBook guide + architecture books). Don't confuse the two.
/examples/
/page/

# The GitHub wiki clone, if you keep one here. Ignored PRE-EMPTIVELY: it is
# not checked out today, and without this entry cloning it in would make
# this repo start tracking a copy of content it already owns — the same
# pages committed twice, in two places, drifting apart.
#
# It is also NOT a source of truth, unlike examples/ and page/. `docs/` is
# the editable source; the wiki is GENERATED from it by
# scripts/docs_to_wiki.py. Edit docs/, regenerate, push the wiki.
/wiki/
*.wiki/
